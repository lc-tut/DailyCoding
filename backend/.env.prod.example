# ============================================================
# 本番環境用 .env テンプレート
# このファイルをコピーして backend/.env.prod を作成し、
# 各値を実際の値で埋めてください。
# .env.prod は .gitignore で管理し、リポジトリにコミットしない。
# ============================================================

# ── 必須: 認証バイパスは本番で必ず false ──────────────────────
AUTH_BYPASS=false

# ── データベース ───────────────────────────────────────────────
# docker-compose.prod.yml の postgres サービス名を使用
DATABASE_URL="postgresql://daileycoding:CHANGE_ME@postgres:5432/daileycoding?sslmode=disable"

# ── フロントエンド ─────────────────────────────────────────────
# Cookie の Secure フラグ付与に使用 (https:// で始めること)
FRONTEND_ORIGIN="https://dailycoding.lcn.ad.jp"

# ── JWT シークレット (必ず強力な乱数を使用) ──────────────────
# 生成コマンド: openssl rand -base64 32
JWT_SECRET="CHANGE_ME"

# ── アクセス制限 ───────────────────────────────────────────────
# カンマ区切りで許可ドメインを指定。未設定 = 全員許可 (危険)。
ALLOWED_DOMAINS=edu.teu.ac.jp,lcn.ad.jp
# 個別許可: INSERT INTO allowed_emails (email, note) VALUES ('...', '...');

# ── Google OIDC ────────────────────────────────────────────────
# コールバック URL は nginx 経由のドメインで設定する
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="CHANGE_ME"
GOOGLE_CALLBACK_URL="https://dailycoding.lcn.ad.jp/api/auth/google/callback"

# ── Keycloak ───────────────────────────────────────────────────
# KEYCLOAK_CLIENT_ID="daileycoding"
# KEYCLOAK_CLIENT_SECRET="CHANGE_ME"
# KEYCLOAK_ISSUER="https://keycloak.lcn.ad.jp/realms/daileycoding"
# KEYCLOAK_CALLBACK_URL="https://dailycoding.lcn.ad.jp/api/auth/keycloak/callback"

# ── コード実行 ─────────────────────────────────────────────────
PYTHON_IMAGE="python:3.14-slim"

# ── サーバー ───────────────────────────────────────────────────
ADDR=":8080"
