# ============================================================
# AUTH_BYPASS モード（プロバイダー不要・ローカル開発用）
# ============================================================
AUTH_BYPASS=true
DATABASE_URL="postgresql://daileycoding:daileycoding@localhost:5432/daileycoding?sslmode=disable"
FRONTEND_ORIGIN="http://localhost:3000"
# ALLOWED_DOMAINS と ALLOWED_EMAILS は未設定 → 全員許可（開発用）

# ============================================================
# Google OIDC を使う場合
# https://console.cloud.google.com/ でプロジェクトを作成し
# リダイレクト URI に http://localhost:8080/api/auth/google/callback を追加する
# ============================================================
# AUTH_BYPASS=false
# DATABASE_URL="postgresql://daileycoding:daileycoding@localhost:5432/daileycoding?sslmode=disable"
# FRONTEND_ORIGIN="http://localhost:3000"
# JWT_SECRET="openssl rand -base64 32 で生成した文字列"
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"
# GOOGLE_CALLBACK_URL="http://localhost:8080/api/auth/google/callback"
#
# ── メールアドレス制限（本番用）──
# カンマ区切りで許可ドメインを指定。未設定 = 制限なし。
# ALLOWED_DOMAINS=edu.teu.ac.jp,lcn.ad.jp
# 個別許可メールは DB に直接 INSERT する:
#   INSERT INTO allowed_emails (email, note) VALUES ('foo@gmail.com', '外部協力者');

# ============================================================
# Keycloak を使う場合
# ============================================================
# AUTH_BYPASS=false
# DATABASE_URL="postgresql://daileycoding:daileycoding@localhost:5432/daileycoding?sslmode=disable"
# FRONTEND_ORIGIN="http://localhost:3000"
# JWT_SECRET="openssl rand -base64 32 で生成した文字列"
# KEYCLOAK_CLIENT_ID="daileycoding"
# KEYCLOAK_CLIENT_SECRET="your-client-secret"
# KEYCLOAK_ISSUER="http://localhost:8180/realms/daileycoding"
# KEYCLOAK_CALLBACK_URL="http://localhost:8080/api/auth/keycloak/callback"
# ALLOWED_DOMAINS=edu.teu.ac.jp,lcn.ad.jp
